# Copy to .env and adjust. All values are optional.
OLLAMA_HOST=http://127.0.0.1:11434
# gemma3:4b = better quality (~8 GB RAM). gemma3:1b = low-RAM laptops (~4 GB RAM).
OLLAMA_MODEL=gemma3:4b
# Seconds to wait for one ticket (CPU-only machines are slow - be patient).
OLLAMA_TIMEOUT=180
DB_PATH=data/lazyticket.db
# Estimated manual triage minutes per ticket (used for "time saved").
MANUAL_MINUTES_PER_TICKET=8
DUPLICATE_THRESHOLD=0.45
